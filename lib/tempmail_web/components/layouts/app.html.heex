<% languages = [
  {"en", "US", "English"},
  {"es", "ES", "Espanol"},
  {"fr", "FR", "Francais"},
  {"de", "DE", "Deutsch"},
  {"pt", "BR", "Portugues"},
  {"zh", "CN", "Chinese"},
  {"ja", "JP", "Japanese"},
  {"ar", "SA", "Arabic"},
  {"ru", "RU", "Russian"},
  {"hi", "IN", "Hindi"},
  {"ko", "KR", "Korean"},
  {"it", "IT", "Italiano"},
  {"nl", "NL", "Nederlands"},
  {"tr", "TR", "Turkce"},
  {"pl", "PL", "Polski"},
  {"vi", "VN", "Tieng Viet"},
  {"th", "TH", "Thai"},
  {"id", "ID", "Bahasa Indonesia"},
  {"sv", "SE", "Svenska"},
  {"el", "GR", "Greek"}
]

current_locale = assigns[:locale] || "en"

current_language =
  Enum.find(languages, fn {code, _, _} -> code == current_locale end) || hd(languages)

locale_home = fn
  "en" -> "/"
  code -> "/#{code}"
end

localized_path = fn path ->
  if current_locale == "en", do: path, else: "/#{current_locale}#{path}"
end %>

<div class="flex min-h-screen flex-col pt-14">
  <header
    data-site-header
    class="fixed left-0 right-0 top-0 z-50 h-14 bg-white/80 backdrop-blur-xl border-b border-slate-200/60 transition-all duration-300"
  >
    <nav class="container mx-auto flex items-center justify-between px-4">
      <.link navigate={localized_path.("/")} class="group flex items-center gap-3">
        <div class="relative">
          <div class="absolute inset-0 rounded-xl opacity-50 blur-lg transition-opacity group-hover:opacity-75 bg-gradient-to-br from-indigo-500 to-purple-600">
          </div>
          <img src={~p"/images/logo.svg"} alt="TempMail" class="relative h-10 w-10 rounded-xl shadow-lg" />
        </div>
        <div class="hidden sm:block">
          <span class="gradient-text text-xl font-bold">TempMail</span>
          <span class="ml-2 hidden text-sm text-slate-500 lg:inline">Central</span>
        </div>
      </.link>

      <div class="hidden items-center gap-2 md:flex">
        <.link
          navigate={localized_path.("/blog")}
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-100"
        >
          <.icon name="hero-book-open" class="h-4 w-4" />
          <span class="hidden lg:inline">Blog</span>
        </.link>
        <details
          id="desktop-language-menu"
          phx-hook="PersistDetails"
          data-menu-id="desktop-language-menu"
          class="group relative"
        >
          <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
            <.icon name="hero-globe-alt" class="h-4 w-4" />
            <span class="text-lg">🇺🇸</span>
            <span class="hidden lg:inline">{elem(current_language, 2)}</span>
            <.icon
              name="hero-chevron-down"
              class="h-4 w-4 transition-transform group-open:rotate-180"
            />
          </summary>
          <div class="glass absolute right-0 mt-2 max-h-80 w-56 overflow-auto rounded-2xl border border-slate-200 py-2 shadow-xl animate-scale-in">
            <div class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
              Select Language
            </div>
            <a
              :for={
                {code, flag, name} <- [
                  {"en", "🇺🇸", "English"},
                  {"es", "🇪🇸", "Español"},
                  {"fr", "🇫🇷", "Français"},
                  {"de", "🇩🇪", "Deutsch"},
                  {"pt", "🇧🇷", "Português"},
                  {"zh", "🇨🇳", "中文"},
                  {"ja", "🇯🇵", "日本語"},
                  {"ar", "🇸🇦", "العربية"},
                  {"ru", "🇷🇺", "Русский"},
                  {"hi", "🇮🇳", "हिन्दी"},
                  {"ko", "🇰🇷", "한국어"},
                  {"it", "🇮🇹", "Italiano"},
                  {"nl", "🇳🇱", "Nederlands"},
                  {"tr", "🇹🇷", "Türkçe"},
                  {"pl", "🇵🇱", "Polski"},
                  {"vi", "🇻🇳", "Tiếng Việt"},
                  {"th", "🇹🇭", "ไทย"},
                  {"id", "🇮🇩", "Bahasa Indonesia"},
                  {"sv", "🇸🇪", "Svenska"},
                  {"el", "🇬🇷", "Ελληνικά"}
                ]
              }
              href={locale_home.(code)}
              class={[
                "flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-indigo-50",
                code == current_locale && "bg-indigo-50 text-indigo-600"
              ]}
            >
              <span class="text-xl">{flag}</span>
              <span class="font-medium">{name}</span>
              <.icon
                :if={code == current_locale}
                name="hero-sparkles"
                class="ml-auto h-4 w-4 text-indigo-500"
              />
            </a>
          </div>
        </details>
        <.link
          :if={@current_user}
          navigate={~p"/dashboard"}
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-100"
        >
          <.icon name="hero-squares-2x2" class="h-4 w-4" />
          <span class="hidden lg:inline">Dashboard</span>
        </.link>
        <.link
          :if={@current_user && @current_user.role in ["ADMIN", "SUPER_ADMIN"]}
          navigate={~p"/admin"}
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-100"
        >
          <.icon name="hero-shield-check" class="h-4 w-4" />
          <span class="hidden lg:inline">Admin</span>
        </.link>
        <.link :if={!@current_user} navigate={~p"/users/log_in"} class="tm-btn-gradient gap-2">
          <.icon name="hero-user" class="h-4 w-4" />
          {TempmailWeb.I18n.t(current_locale, "auth.signIn", "Sign In")}
        </.link>
        <.link
          :if={@current_user}
          href={~p"/users/log_out"}
          method="delete"
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-red-50 hover:text-red-600"
        >
          <.icon name="hero-arrow-left-on-rectangle" class="h-4 w-4" />
          {TempmailWeb.I18n.t(current_locale, "auth.signOut", "Sign Out")}
        </.link>
      </div>

      <details
        id="mobile-site-menu"
        phx-hook="PersistDetails"
        data-menu-id="mobile-site-menu"
        class="group relative md:hidden"
      >
        <summary
          class="relative flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl transition-colors hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <div class="relative flex h-5 w-6 flex-col justify-between">
            <span class="block h-0.5 rounded-full bg-current transition-all duration-300 group-open:translate-y-2 group-open:rotate-45">
            </span>
            <span class="block h-0.5 rounded-full bg-current transition-all duration-300 group-open:scale-0 group-open:opacity-0">
            </span>
            <span class="block h-0.5 rounded-full bg-current transition-all duration-300 group-open:-translate-y-2 group-open:-rotate-45">
            </span>
          </div>
        </summary>
        <div class="fixed inset-x-0 bottom-0 top-[72px] overflow-auto bg-white/95 backdrop-blur-xl transition-all duration-300">
          <div class="container mx-auto space-y-6 px-4 py-6">
            <.link
              navigate={localized_path.("/blog")}
              class="flex h-12 w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 font-semibold shadow-sm"
            >
              <.icon name="hero-book-open" class="h-5 w-5 text-indigo-500" /> Blog
            </.link>

            <div>
              <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500">
                Language
              </p>
              <div class="grid max-h-48 grid-cols-2 gap-2 overflow-auto">
                <a
                  :for={
                    {code, flag, name} <- [
                      {"en", "🇺🇸", "English"},
                      {"es", "🇪🇸", "Español"},
                      {"fr", "🇫🇷", "Français"},
                      {"de", "🇩🇪", "Deutsch"},
                      {"pt", "🇧🇷", "Português"},
                      {"zh", "🇨🇳", "中文"},
                      {"ja", "🇯🇵", "日本語"},
                      {"ar", "🇸🇦", "العربية"}
                    ]
                  }
                  href={locale_home.(code)}
                  class={[
                    "flex items-center gap-2 rounded-xl p-3 transition-colors",
                    code == current_locale && "bg-indigo-100 text-indigo-600",
                    code != current_locale && "bg-slate-100 hover:bg-slate-200"
                  ]}
                >
                  <span class="text-xl">{flag}</span>
                  <span class="truncate text-sm font-medium">{name}</span>
                </a>
              </div>
              <details
                id="mobile-language-menu"
                phx-hook="PersistDetails"
                data-menu-id="mobile-language-menu"
                class="group/lang mt-2"
              >
                <summary class="w-full cursor-pointer list-none rounded-xl bg-indigo-50 p-3 text-center text-sm font-medium text-indigo-600 [&::-webkit-details-marker]:hidden">
                  View all 20 languages
                </summary>
                <div class="mt-2 grid max-h-48 grid-cols-2 gap-2 overflow-auto rounded-xl border border-indigo-100 bg-white p-2">
                  <a
                    :for={
                      {code, flag, name} <- [
                        {"ru", "🇷🇺", "Русский"},
                        {"hi", "🇮🇳", "हिन्दी"},
                        {"ko", "🇰🇷", "한국어"},
                        {"it", "🇮🇹", "Italiano"},
                        {"nl", "🇳🇱", "Nederlands"},
                        {"tr", "🇹🇷", "Türkçe"},
                        {"pl", "🇵🇱", "Polski"},
                        {"vi", "🇻🇳", "Tiếng Việt"},
                        {"th", "🇹🇭", "ไทย"},
                        {"id", "🇮🇩", "Bahasa Indonesia"},
                        {"sv", "🇸🇪", "Svenska"},
                        {"el", "🇬🇷", "Ελληνικά"}
                      ]
                    }
                    href={locale_home.(code)}
                    class={[
                      "flex items-center gap-2 rounded-xl p-3 transition-colors",
                      code == current_locale && "bg-indigo-100 text-indigo-600",
                      code != current_locale && "bg-slate-100 hover:bg-slate-200"
                    ]}
                  >
                    <span class="text-xl">{flag}</span>
                    <span class="truncate text-sm font-medium">{name}</span>
                  </a>
                </div>
              </details>
            </div>

            <div class="border-t border-slate-200 pt-6">
              <div :if={@current_user} class="space-y-3">
                <div class="flex items-center gap-3 rounded-xl bg-slate-100 p-3">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-lg font-bold text-white">
                    {String.first(@current_user.email || "U") |> String.upcase()}
                  </div>
                  <div class="min-w-0">
                    <p class="truncate font-semibold">{@current_user.email}</p>
                    <p class="text-sm text-slate-500">Signed in</p>
                  </div>
                </div>
                <.link
                  navigate={~p"/dashboard"}
                  class="flex h-12 w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 font-semibold shadow-sm"
                >
                  <.icon name="hero-squares-2x2" class="h-5 w-5 text-indigo-500" /> Dashboard
                </.link>
                <.link
                  :if={@current_user.role in ["ADMIN", "SUPER_ADMIN"]}
                  navigate={~p"/admin"}
                  class="flex h-12 w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 font-semibold shadow-sm"
                >
                  <.icon name="hero-shield-check" class="h-5 w-5 text-indigo-500" /> Admin
                </.link>
                <.link
                  href={~p"/users/log_out"}
                  method="delete"
                  class="flex h-12 w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 font-semibold shadow-sm hover:border-red-200 hover:bg-red-50 hover:text-red-600"
                >
                  <.icon name="hero-arrow-left-on-rectangle" class="h-5 w-5" />
                  {TempmailWeb.I18n.t(current_locale, "auth.signOut", "Sign Out")}
                </.link>
              </div>
              <.link
                :if={!@current_user}
                navigate={~p"/users/log_in"}
                class="tm-btn-gradient flex h-12 w-full justify-center gap-2"
              >
                <.icon name="hero-user" class="h-5 w-5" />
                {TempmailWeb.I18n.t(current_locale, "auth.signIn", "Sign In")}
              </.link>
            </div>
          </div>
        </div>
      </details>
    </nav>
  </header>

  <.link :if={!@current_user} navigate={~p"/users/register"} class="sr-only">Register</.link>
  <.link :if={@current_user} navigate={~p"/users/settings"} class="sr-only">Settings</.link>
  <span :if={@current_user} class="sr-only">Log out</span>

  <main class="flex-1 pt-16 sm:pt-20">
    <span :if={@current_user} class="sr-only">{@current_user.email}</span>
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>

  <footer class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-slate-50 to-slate-100"></div>
    <div class="absolute left-1/2 top-0 h-[400px] w-[800px] -translate-x-1/2 rounded-full bg-gradient-to-r from-indigo-500/5 via-purple-500/5 to-pink-500/5 blur-3xl">
    </div>
    <div class="relative">
      <svg
        class="-mb-1 h-12 w-full text-white"
        viewBox="0 0 1440 48"
        fill="currentColor"
        preserveAspectRatio="none"
      >
        <path d="M0,48L60,42.7C120,37,240,27,360,26.7C480,27,600,37,720,42.7C840,48,960,48,1080,42.7C1200,37,1320,27,1380,21.3L1440,16L1440,0L1380,0C1320,0,1200,0,1080,0C960,0,840,0,720,0C600,0,480,0,360,0C240,0,120,0,60,0L0,0Z">
        </path>
      </svg>

      <div class="container mx-auto px-4 py-16">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <.link navigate={~p"/"} class="group mb-6 inline-flex items-center gap-3">
              <div class="relative">
                <div class="absolute inset-0 rounded-xl opacity-50 blur-lg transition-opacity group-hover:opacity-75 bg-gradient-to-br from-indigo-500 to-purple-600">
                </div>
                <img src={~p"/images/logo.svg"} alt="TempMail" class="relative h-12 w-12 rounded-xl shadow-lg" />
              </div>
              <div>
                <span class="gradient-text text-2xl font-bold">TempMail</span>
                <span class="ml-1 text-lg text-slate-500">Central</span>
              </div>
            </.link>
            <p class="mb-6 max-w-md leading-relaxed text-slate-500">
              {TempmailWeb.I18n.t(
                current_locale,
                "footer.description",
                "The fastest and most secure temporary email service. Protect your privacy with disposable email addresses that auto-delete. No registration required."
              )}
            </p>
            <div class="mb-6 flex flex-wrap gap-3">
              <div class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-sm font-medium shadow-sm">
                <.icon name="hero-shield-check" class="h-4 w-4 text-indigo-500" />
                {TempmailWeb.I18n.t(current_locale, "footer.privateSecure", "Private & Secure")}
              </div>
              <div class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-sm font-medium shadow-sm">
                <.icon name="hero-bolt" class="h-4 w-4 text-indigo-500" />
                {TempmailWeb.I18n.t(current_locale, "footer.instantDelivery", "Instant Delivery")}
              </div>
              <div class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-sm font-medium shadow-sm">
                <.icon name="hero-globe-alt" class="h-4 w-4 text-indigo-500" />
                {TempmailWeb.I18n.t(current_locale, "footer.languages", "20+ Languages")}
              </div>
            </div>
            <div class="flex items-center gap-3">
              <a
                href="https://github.com"
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-slate-500 transition-all hover:-translate-y-1 hover:text-slate-950 hover:shadow-md"
                aria-label="GitHub"
              >
                G
              </a>
              <a
                href="https://twitter.com"
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-slate-500 transition-all hover:-translate-y-1 hover:text-slate-950 hover:shadow-md"
                aria-label="Twitter"
              >
                X
              </a>
            </div>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
              <div>
                <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
                  Product
                </h3>
                <ul class="space-y-3">
                  <li>
                    <.link
                      navigate={~p"/"}
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>Home</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </.link>
                  </li>
                  <li>
                    <a
                      href="/#features"
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>Features</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </a>
                  </li>
                  <li>
                    <a
                      href="/#how-it-works"
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>How it works</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </a>
                  </li>
                </ul>
              </div>
              <div>
                <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
                  Legal
                </h3>
                <ul class="space-y-3">
                  <li>
                    <.link
                      navigate={~p"/privacy"}
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>Privacy Policy</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </.link>
                  </li>
                  <li>
                    <.link
                      navigate={~p"/terms"}
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>Terms of Service</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </.link>
                  </li>
                </ul>
              </div>
              <div>
                <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
                  Company
                </h3>
                <ul class="space-y-3">
                  <li>
                    <.link
                      navigate={~p"/about"}
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>About</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </.link>
                  </li>
                  <li>
                    <a
                      href="mailto:contact@tempmailcentral.com"
                      class="group inline-flex items-center gap-1 hover:text-indigo-600"
                    >
                      <span>Contact</span><span class="-translate-x-2 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100">→</span>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-200">
        <div class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row">
          <p class="text-sm text-slate-500">
            © {Date.utc_today().year} TempMail. All rights reserved.
          </p>
          <p class="flex items-center gap-1 text-sm text-slate-500">
            Made with <.icon name="hero-heart" class="h-4 w-4 fill-red-500 text-red-500" />
            for privacy
          </p>
        </div>
      </div>
    </div>
  </footer>
</div>
