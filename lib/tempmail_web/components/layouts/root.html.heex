<!DOCTYPE html>
<html lang={assigns[:html_lang] || "en"} class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta :if={assigns[:meta_keywords]} name="keywords" content={assigns[:meta_keywords]} />
    <TempmailWeb.SEOComponents.structured_data page={assigns[:seo_page] || :other} />
    <meta :if={assigns[:meta_description]} name="description" content={assigns[:meta_description]} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />
    <%= if assigns[:hreflang] do %>
      <link :for={{lang, url} <- assigns[:hreflang]} rel="alternate" hreflang={lang} href={url} />
    <% end %>
    <meta :if={assigns[:og_title]} property="og:title" content={assigns[:og_title]} />
    <meta :if={assigns[:og_description]} property="og:description" content={assigns[:og_description]} />
    <meta :if={assigns[:og_url]} property="og:url" content={assigns[:og_url]} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:locale" content={assigns[:og_locale] || "en_US"} />
    <meta property="og:site_name" content="TempMailCentral" />
    <meta :if={assigns[:og_image]} property="og:image" content={assigns[:og_image]} />
    <meta :if={assigns[:og_image]} property="og:image:width" content="1200" />
    <meta :if={assigns[:og_image]} property="og:image:height" content="630" />
    <meta :if={assigns[:og_image]} property="og:image:alt" content="TempMailCentral - Free Disposable Temporary Email" />
    <meta :if={assigns[:og_published_time]} property="article:published_time" content={assigns[:og_published_time]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta :if={assigns[:og_title]} name="twitter:title" content={assigns[:og_title]} />
    <meta :if={assigns[:og_description]} name="twitter:description" content={assigns[:og_description]} />
    <meta :if={assigns[:og_image]} name="twitter:image" content={assigns[:og_image]} />
    <meta name="twitter:creator" content="@tempmailcentral" />
    <.live_title default="TempMailCentral" suffix=" | Temp Mail - Disposable Temporary Email">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
