<.admin_shell locale={@locale} active={:analytics}>
  <div class="space-y-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="bg-gradient-to-r from-slate-900 to-slate-600 bg-clip-text text-3xl font-bold tracking-tight text-transparent">
          Analytics
        </h1>
        <p class="mt-1 text-slate-500">Track email usage patterns and performance metrics.</p>
      </div>
      <div class="flex rounded-lg bg-slate-100 p-1">
        <button
          :for={range <- [7, 30, 90]}
          phx-click="range"
          phx-value-days={range}
          class={[
            "rounded-md px-3 py-2 text-sm font-semibold",
            @days == range && "bg-white text-slate-950 shadow-sm",
            @days != range && "text-slate-600 hover:bg-slate-200"
          ]}
        >
          {range} Days
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div
        :for={
          {title, value, subtitle, icon, glow_class, icon_bg_class, icon_class} <- [
            {"Emails Generated", @total_generated, "Selected period", "hero-envelope",
             "bg-blue-500/10", "bg-blue-500/20", "text-blue-500"},
            {"Emails Received", @total_received, "Selected period", "hero-inbox",
             "bg-purple-500/10", "bg-purple-500/20", "text-purple-500"},
            {"Conversion Rate", "#{@conversion}%", "Received / Generated", "hero-chart-pie",
             "bg-emerald-500/10", "bg-emerald-500/20", "text-emerald-500"},
            {"Daily Average", @avg_daily, "Emails per day", "hero-arrow-trending-up",
             "bg-orange-500/10", "bg-orange-500/20", "text-orange-500"}
          ]
        }
        class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
      >
        <div class={"absolute right-0 top-0 h-32 w-32 translate-x-8 -translate-y-8 rounded-full #{glow_class}"}>
        </div>
        <div class="relative flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">{title}</p>
            <p class="mt-3 text-3xl font-bold text-slate-950">{value}</p>
            <p class="mt-1 text-xs text-slate-500">{subtitle}</p>
          </div>
          <div class={"rounded-lg #{icon_bg_class} p-2"}>
            <.icon name={icon} class={"h-4 w-4 #{icon_class}"} />
          </div>
        </div>
      </div>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5">
        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
          <.icon name="hero-sparkles" class="h-5 w-5 text-blue-600" /> Email Activity Trend
        </h2>
        <p class="text-sm text-slate-500">Daily email generation and reception over time.</p>
      </div>
      <div class="p-5">
        <div class="grid gap-3">
          <div
            :for={stat <- @stats}
            class="grid grid-cols-[8rem_1fr_4rem_4rem] items-center gap-3 text-sm"
          >
            <span class="font-medium text-slate-700">
              {Calendar.strftime(stat.date, "%b %d")}
            </span>
            <% total = stat.generated + stat.received %>
            <% max_total =
              Enum.max([
                Enum.max(Enum.map(@stats, &(&1.generated + &1.received)), fn -> 1 end),
                1
              ]) %>
            <div class="h-2 overflow-hidden rounded-full bg-slate-100">
              <div
                class="h-full rounded-full bg-gradient-to-r from-blue-500 to-purple-500"
                style={"width: #{round(total / max_total * 100)}%"}
              >
              </div>
            </div>
            <span class="text-right font-semibold text-blue-600">{stat.generated}</span>
            <span class="text-right font-semibold text-purple-600">{stat.received}</span>
          </div>
          <div :if={@stats == []} class="py-12 text-center text-slate-500">
            No analytics data yet.
          </div>
        </div>
      </div>
    </section>
  </div>
</.admin_shell>
