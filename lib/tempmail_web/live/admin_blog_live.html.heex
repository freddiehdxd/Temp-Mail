<.admin_shell locale={@locale} active={:blog}>
  <% posts = filtered_posts(@posts, @search, @status_filter) %>
  <%= if @live_action == :categories do %>
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Categories</h1>
          <p class="text-sm text-slate-500">{length(@categories)} categories</p>
        </div>
        <.link
          navigate={if @locale == "en", do: ~p"/admin/blog", else: "/#{@locale}/admin/blog"}
          class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          <.icon name="hero-arrow-left-mini" class="h-4 w-4" /> Back to Posts
        </.link>
      </div>

      <.form for={@category_form} phx-submit="create_category" class="flex items-center gap-3">
        <input name="slug" value={@category_form[:slug].value} placeholder="category-slug" required class="h-9 flex-1 rounded-lg border border-slate-300 px-3 text-sm" />
        <input name="sort_order" value={@category_form[:sort_order].value} type="number" placeholder="Order" class="h-9 w-24 rounded-lg border border-slate-300 px-3 text-sm" />
        <button class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700">
          <.icon name="hero-plus-mini" class="h-4 w-4" /> Add
        </button>
      </.form>

      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <table class="w-full">
          <thead class="border-b border-slate-200 bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Category</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Order</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr :if={@categories == []} class="text-center">
              <td colspan="3" class="px-4 py-8 text-sm text-slate-500">No categories yet</td>
            </tr>
            <tr :for={cat <- @categories} class="hover:bg-slate-50">
              <td class="px-4 py-3 text-sm font-semibold text-slate-900">{cat.slug}</td>
              <td class="px-4 py-3 text-sm text-slate-500">{cat.sort_order}</td>
              <td class="px-4 py-3 text-right">
                <button phx-click="delete_category" phx-value-id={cat.id} data-confirm="Delete this category?" class="rounded-md px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50">Delete</button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Blog Posts</h1>
          <p class="text-sm text-slate-500">Manage your blog content in multiple languages</p>
        </div>
        <div class="flex gap-2">
          <.link navigate={if @locale == "en", do: ~p"/admin/blog/categories", else: "/#{@locale}/admin/blog/categories"} class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 hover:bg-slate-50">
            <.icon name="hero-tag-mini" class="h-4 w-4" /> Categories
          </.link>
          <.link navigate={if @locale == "en", do: ~p"/admin/blog/new", else: "/#{@locale}/admin/blog/new"} class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700">
            <.icon name="hero-plus-mini" class="h-4 w-4" /> New Post
          </.link>
        </div>
      </div>

      <div :if={@error} class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">{@error}</div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <form phx-change="search" class="relative flex-1">
          <.icon name="hero-magnifying-glass-mini" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
          <input type="text" name="q" value={@search} placeholder="Search posts..." phx-debounce="200" class="h-9 w-full rounded-lg border border-slate-300 pl-9 pr-3 text-sm" />
        </form>
        <div class="flex gap-1.5">
          <button :for={{label, value} <- [{"All", "all"}, {"Published", "PUBLISHED"}, {"Draft", "DRAFT"}, {"Archived", "ARCHIVED"}]} phx-click="filter" phx-value-status={value} class={["h-9 rounded-lg px-3 text-sm font-medium transition-colors", @status_filter == value && "bg-blue-600 text-white", @status_filter != value && "bg-slate-100 text-slate-700 hover:bg-slate-200"]}>
            {label}
          </button>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <div :if={posts == []} class="p-12 text-center">
          <.icon name="hero-document-text" class="mx-auto mb-4 h-12 w-12 text-slate-300" />
          <h3 class="text-lg font-semibold text-slate-900">No posts found</h3>
          <p class="mb-4 text-sm text-slate-500">{if @search != "" || @status_filter != "all", do: "Try a different search or filter", else: "Create your first blog post to get started"}</p>
        </div>
        <table :if={posts != []} class="w-full">
          <thead class="border-b border-slate-200 bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Title</th>
              <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 md:table-cell">Status</th>
              <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 lg:table-cell">Languages</th>
              <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 lg:table-cell">Date</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr :for={post <- posts} class="group hover:bg-slate-50">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600">
                    <.icon name="hero-document-text-mini" class="h-5 w-5 text-white" />
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-slate-900">{post_title(post)}</p>
                    <p class="text-xs text-slate-500">/{post.slug}</p>
                  </div>
                </div>
              </td>
              <td class="hidden px-4 py-3 md:table-cell">
                <span class={["inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium", post.status == "PUBLISHED" && "bg-emerald-100 text-emerald-700", post.status == "DRAFT" && "bg-slate-100 text-slate-600", post.status == "ARCHIVED" && "bg-amber-100 text-amber-700"]}>
                  {String.capitalize(String.downcase(post.status))}
                </span>
              </td>
              <td class="hidden px-4 py-3 lg:table-cell">
                <span class="text-sm text-slate-500">{length(post.translations)}/20</span>
              </td>
              <td class="hidden px-4 py-3 lg:table-cell">
                <span class="text-xs text-slate-500">{Calendar.strftime(post.published_at || post.inserted_at, "%b %d, %Y")}</span>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="inline-flex items-center gap-1">
                  <.link navigate={if @locale == "en", do: "/blog/#{post.slug}", else: "/#{@locale}/blog/#{post.slug}"} target="_blank" class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100">
                    <.icon name="hero-eye-mini" class="h-4 w-4" />
                  </.link>
                  <.link navigate={if @locale == "en", do: ~p"/admin/blog/#{post.id}", else: "/#{@locale}/admin/blog/#{post.id}"} class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100">
                    <.icon name="hero-pencil-mini" class="h-4 w-4" />
                  </.link>
                  <button phx-click="delete_post" phx-value-id={post.id} data-confirm="Delete this post permanently?" class="rounded-md p-1.5 text-red-500 hover:bg-red-50">
                    <.icon name="hero-trash-mini" class="h-4 w-4" />
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</.admin_shell>
