<.admin_shell locale={@locale} active={:blog}>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-950">Blog</h1>
      <p class="mt-1 text-slate-500">Manage localized blog posts and categories.</p>
    </div>

    <div
      :if={@error}
      class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
    >
      {@error}
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-slate-950">New Post</h2>
        <.form for={@post_form} phx-submit="create_post" class="mt-5 space-y-4">
          <input
            name="slug"
            value={@post_form[:slug].value}
            placeholder="post-slug"
            class="h-11 w-full rounded-lg border border-slate-200 px-3 text-sm"
          />
          <select
            name="status"
            class="h-11 w-full rounded-lg border border-slate-200 px-3 text-sm"
          >
            <option>DRAFT</option>
            <option>PUBLISHED</option>
            <option>ARCHIVED</option>
          </select>
          <button class="tm-btn-gradient gap-2">
            <.icon name="hero-plus" class="h-4 w-4" /> Create Post
          </button>
        </.form>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-slate-950">New Category</h2>
        <.form for={@category_form} phx-submit="create_category" class="mt-5 space-y-4">
          <input
            name="slug"
            value={@category_form[:slug].value}
            placeholder="category-slug"
            class="h-11 w-full rounded-lg border border-slate-200 px-3 text-sm"
          />
          <input
            name="sort_order"
            value={@category_form[:sort_order].value}
            type="number"
            class="h-11 w-full rounded-lg border border-slate-200 px-3 text-sm"
          />
          <button class="tm-btn-gradient gap-2">
            <.icon name="hero-plus" class="h-4 w-4" /> Create Category
          </button>
        </.form>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5">
        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
          <.icon name="hero-document-text" class="h-5 w-5" /> Posts ({length(@posts)})
        </h2>
      </div>
      <div class="divide-y divide-slate-100">
        <div :if={@posts == []} class="p-10 text-center text-slate-500">No posts yet.</div>
        <div :for={post <- @posts} class="flex items-center justify-between p-4">
          <div>
            <p class="font-semibold text-slate-950">{post.slug}</p>
            <p class="text-sm text-slate-500">
              {length(post.translations)} translations · {post.view_count} views
            </p>
          </div>
          <span class={[
            "rounded-full px-2.5 py-1 text-xs font-bold",
            post.status == "PUBLISHED" && "bg-green-100 text-green-700",
            post.status == "DRAFT" && "bg-slate-100 text-slate-700",
            post.status == "ARCHIVED" && "bg-amber-100 text-amber-700"
          ]}>
            {post.status}
          </span>
        </div>
      </div>
    </section>
  </div>
</.admin_shell>
