<.admin_shell locale={@locale} active={:domains}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Domains</h1>
        <p class="text-sm text-slate-500">{length(@domains)} domains configured</p>
      </div>
    </div>

    <div :if={@error} class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
      {@error}
    </div>

    <.form for={@form} phx-submit="create" class="flex items-center gap-3">
      <input
        type="text"
        name="domain"
        placeholder="example.com"
        required
        class="h-9 flex-1 rounded-lg border border-slate-300 px-3 text-sm focus:border-blue-500 focus:ring-blue-500"
      />
      <input
        type="text"
        name="description"
        placeholder="Description (optional)"
        class="hidden h-9 rounded-lg border border-slate-300 px-3 text-sm focus:border-blue-500 focus:ring-blue-500 sm:block sm:w-48"
      />
      <button
        type="submit"
        class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700"
      >
        <.icon name="hero-plus-mini" class="h-4 w-4" /> Add
      </button>
    </.form>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="w-full">
        <thead class="border-b border-slate-200 bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              Domain
            </th>
            <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 sm:table-cell">
              Status
            </th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr :if={@domains == []} class="text-center">
            <td colspan="3" class="px-4 py-8 text-sm text-slate-500">No domains yet</td>
          </tr>
          <tr :for={domain <- @domains} class="group hover:bg-slate-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <div class={[
                  "flex h-8 w-8 items-center justify-center rounded-lg text-white",
                  domain.is_active && "bg-emerald-500",
                  !domain.is_active && "bg-slate-400"
                ]}>
                  <.icon name="hero-globe-alt-mini" class="h-4 w-4" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-900">{domain.domain}</p>
                  <p :if={domain.description} class="text-xs text-slate-500">
                    {domain.description}
                  </p>
                </div>
              </div>
            </td>
            <td class="hidden px-4 py-3 sm:table-cell">
              <div class="flex items-center gap-2">
                <span class={[
                  "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
                  domain.is_active && "bg-emerald-100 text-emerald-700",
                  !domain.is_active && "bg-slate-100 text-slate-600"
                ]}>
                  {if domain.is_active, do: "Active", else: "Inactive"}
                </span>
                <span
                  :if={domain.is_default}
                  class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700"
                >
                  Default
                </span>
              </div>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex items-center gap-1">
                <button
                  phx-click="toggle"
                  phx-value-id={domain.id}
                  class={[
                    "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
                    domain.is_active && "text-amber-700 hover:bg-amber-50",
                    !domain.is_active && "text-emerald-700 hover:bg-emerald-50"
                  ]}
                >
                  {if domain.is_active, do: "Disable", else: "Enable"}
                </button>
                <button
                  :if={!domain.is_default}
                  phx-click="default"
                  phx-value-id={domain.id}
                  class="rounded-md px-2.5 py-1 text-xs font-medium text-blue-700 hover:bg-blue-50"
                >
                  Set Default
                </button>
                <button
                  :if={!domain.is_default}
                  phx-click="delete"
                  phx-value-id={domain.id}
                  data-confirm="Delete this domain permanently?"
                  class="rounded-md px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</.admin_shell>
