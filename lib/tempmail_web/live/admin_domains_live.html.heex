<.admin_shell locale={@locale} active={:domains}>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-950">System Domains</h1>
      <p class="mt-1 text-slate-500">Domains used for generated temporary addresses.</p>
    </div>

    <div
      :if={@error}
      class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
    >
      {@error}
    </div>

    <.form
      for={@form}
      phx-submit="create"
      class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[1fr_1fr_auto]"
    >
      <input
        name="domain"
        value={@form[:domain].value}
        placeholder="tempmail.com"
        class="h-12 rounded-xl border-2 border-slate-200 bg-white px-4 text-sm font-semibold"
      />
      <input
        name="description"
        value={@form[:description].value}
        placeholder="Description"
        class="h-12 rounded-xl border-2 border-slate-200 bg-white px-4 text-sm font-semibold"
      />
      <button class="tm-btn-gradient h-12 gap-2">
        <.icon name="hero-plus" class="h-4 w-4" /> Add
      </button>
    </.form>

    <div class="grid gap-4">
      <article
        :for={domain <- @domains}
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-500 text-white shadow-lg">
              <.icon name="hero-globe-alt" class="h-6 w-6" />
            </div>
            <div>
              <h2 class="text-xl font-bold text-slate-950">{domain.domain}</h2>
              <p class="mt-1 text-sm text-slate-500">{domain.description}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs font-bold">
                <span class={[
                  "rounded-full px-3 py-1",
                  domain.is_active && "bg-emerald-50 text-emerald-700",
                  !domain.is_active && "bg-slate-100 text-slate-500"
                ]}>
                  {if domain.is_active, do: "Active", else: "Inactive"}
                </span>
                <span
                  :if={domain.is_default}
                  class="rounded-full bg-indigo-50 px-3 py-1 text-indigo-700"
                >
                  Default
                </span>
              </div>
            </div>
          </div>
          <div class="flex gap-2">
            <button phx-click="toggle" phx-value-id={domain.id} class="tm-btn-outline">
              Toggle
            </button>
            <button phx-click="default" phx-value-id={domain.id} class="tm-btn-gradient">
              Default
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</.admin_shell>
