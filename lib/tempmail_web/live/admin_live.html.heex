<.admin_shell locale={@locale} active={:dashboard}>
  <div class="space-y-8">
    <%!-- Header --%>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="bg-gradient-to-r from-slate-900 to-slate-600 bg-clip-text text-3xl font-bold tracking-tight text-transparent">
          Dashboard
        </h1>
        <p class="mt-1 text-slate-500">
          Welcome back. Here's what's happening with your email service.
        </p>
      </div>
      <div class="flex items-center gap-2 text-sm text-slate-500">
        <.icon name="hero-clock" class="h-4 w-4" />
        <span>Last updated: {Calendar.strftime(DateTime.utc_now(), "%I:%M %p")}</span>
      </div>
    </div>

    <%!-- Stat Cards --%>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <.stat_card
        title="Emails Generated"
        value={@total_generated}
        subtitle="Last 7 days"
        trend={@generated_trend}
        icon="hero-envelope"
        color="blue"
        href={if @locale == "en", do: ~p"/admin/analytics", else: "/#{@locale}/admin/analytics"}
      />
      <.stat_card
        title="Emails Received"
        value={@total_received}
        subtitle="Last 7 days"
        trend={@received_trend}
        icon="hero-inbox"
        color="purple"
        href={if @locale == "en", do: ~p"/admin/analytics", else: "/#{@locale}/admin/analytics"}
      />
      <.stat_card
        title="Active Domains"
        value={Enum.count(@domains, & &1.is_active)}
        subtitle={"#{length(@domains)} total configured"}
        icon="hero-globe-alt"
        color="emerald"
        href={if @locale == "en", do: ~p"/admin/domains", else: "/#{@locale}/admin/domains"}
      />
      <.stat_card
        title="Total Users"
        value={length(@users)}
        subtitle={"+#{@new_users_count} this week"}
        icon="hero-users"
        color="orange"
        href={if @locale == "en", do: ~p"/admin/users", else: "/#{@locale}/admin/users"}
      />
    </div>

    <%!-- Charts Row --%>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <.chart_card title="Activity Trend" subtitle="Email generation and delivery over time">
        <div class="h-72">
          <canvas
            id="activity-chart"
            phx-hook="ChartHook"
            data-config={Jason.encode!(activity_chart_config(@chart_data))}
            phx-update="ignore"
          >
          </canvas>
        </div>
      </.chart_card>
      <.chart_card title="Daily Breakdown" subtitle="Generated vs received per day">
        <div class="h-72">
          <canvas
            id="breakdown-chart"
            phx-hook="ChartHook"
            data-config={Jason.encode!(bar_chart_config(@chart_data))}
            phx-update="ignore"
          >
          </canvas>
        </div>
      </.chart_card>
    </div>

    <%!-- Bottom Row: Recent Mailboxes + System Status --%>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 p-5">
          <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
            <.icon name="hero-bolt" class="h-5 w-5 text-blue-600" /> Recent Mailboxes
          </h2>
          <p class="text-sm text-slate-500">Latest temporary email addresses created</p>
        </div>
        <div class="divide-y divide-slate-100">
          <div :if={@sessions == []} class="p-8 text-center text-slate-500">
            No mailboxes created yet
          </div>
          <.mailbox_row :for={session <- @sessions} session={session} />
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 p-5">
          <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
            <.icon name="hero-server-stack" class="h-5 w-5 text-blue-600" /> System Status
          </h2>
          <p class="text-sm text-slate-500">Current health of system services</p>
        </div>
        <div class="space-y-1 p-5">
          <.status_row
            :for={service <- ["Email Server", "Database", "Redis", "Web Server"]}
            name={service}
            status="Operational"
          />
        </div>
      </section>
    </div>

    <%!-- Quick Actions --%>
    <div>
      <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-slate-950">
        <.icon name="hero-bolt" class="h-5 w-5 text-blue-600" /> Quick Actions
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <.link
          :for={
            {title, desc, icon, href, bg_class, icon_class} <- [
              {"Manage Domains", "Add or configure email domains", "hero-globe-alt",
               "/admin/domains", "bg-blue-100", "text-blue-600"},
              {"View Users", "Manage user accounts", "hero-users", "/admin/users", "bg-purple-100",
               "text-purple-600"},
              {"Analytics", "Detailed usage statistics", "hero-chart-bar", "/admin/analytics",
               "bg-emerald-100", "text-emerald-600"},
              {"Settings", "Configure system settings", "hero-cog-6-tooth", "/admin/settings",
               "bg-orange-100", "text-orange-600"}
            ]
          }
          navigate={if @locale == "en", do: href, else: "/#{@locale}#{href}"}
          class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="flex items-center gap-4">
            <div class={"flex h-12 w-12 items-center justify-center rounded-xl #{bg_class}"}>
              <.icon name={icon} class={"h-6 w-6 #{icon_class}"} />
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-slate-950">{title}</h3>
              <p class="text-sm text-slate-500">{desc}</p>
            </div>
            <.icon
              name="hero-arrow-up-right"
              class="h-5 w-5 text-slate-400 opacity-0 transition-opacity group-hover:opacity-100"
            />
          </div>
        </.link>
      </div>
    </div>
  </div>
</.admin_shell>
