<.admin_shell locale={@locale} active={:users}>
  <% users = filtered_users(@users, @search) %>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Users</h1>
        <p class="text-sm text-slate-500">{length(@users)} total users</p>
      </div>
    </div>

    <form phx-change="search" class="relative">
      <.icon
        name="hero-magnifying-glass-mini"
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
      />
      <input
        type="text"
        name="q"
        value={@search}
        placeholder="Search by name or email..."
        phx-debounce="200"
        class="h-9 w-full rounded-lg border border-slate-300 pl-9 pr-3 text-sm focus:border-blue-500 focus:ring-blue-500 sm:w-80"
      />
    </form>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="w-full">
        <thead class="border-b border-slate-200 bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              User
            </th>
            <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 md:table-cell">
              Role
            </th>
            <th class="hidden px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500 sm:table-cell">
              Joined
            </th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr :if={users == []} class="text-center">
            <td colspan="4" class="px-4 py-8 text-sm text-slate-500">No users found</td>
          </tr>
          <tr :for={user <- users} class="group hover:bg-slate-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <div :if={user.image} class="h-8 w-8 overflow-hidden rounded-full">
                  <img src={user.image} alt="" class="h-full w-full object-cover" />
                </div>
                <div
                  :if={!user.image}
                  class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-purple-600 text-xs font-bold text-white"
                >
                  {String.first(user.name || user.email) |> String.upcase()}
                </div>
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-900">
                    {user.name || "No name"}
                  </p>
                  <p class="truncate text-xs text-slate-500">{user.email}</p>
                </div>
              </div>
            </td>
            <td class="hidden px-4 py-3 md:table-cell">
              <div class="flex flex-wrap items-center gap-1.5">
                <span
                  :if={user.role == "SUPER_ADMIN"}
                  class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700"
                >
                  Super Admin
                </span>
                <span
                  :if={user.role == "ADMIN"}
                  class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700"
                >
                  Admin
                </span>
                <span
                  :if={user.role == "USER"}
                  class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"
                >
                  User
                </span>
                <span
                  :if={user.banned}
                  class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700"
                >
                  Banned
                </span>
              </div>
            </td>
            <td class="hidden px-4 py-3 text-xs text-slate-500 sm:table-cell">
              {Calendar.strftime(user.inserted_at, "%b %d, %Y")}
            </td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex items-center gap-1">
                <button
                  :if={
                    @current_user.role == "SUPER_ADMIN" and user.role != "SUPER_ADMIN" and
                      user.id != @current_user.id
                  }
                  phx-click="toggle_admin"
                  phx-value-id={user.id}
                  class="rounded-md px-2.5 py-1 text-xs font-medium text-blue-700 hover:bg-blue-50"
                >
                  {if user.role == "ADMIN", do: "Remove Admin", else: "Make Admin"}
                </button>
                <button
                  :if={
                    !user.banned and user.id != @current_user.id and user.role != "SUPER_ADMIN"
                  }
                  phx-click="ban"
                  phx-value-id={user.id}
                  data-confirm={"Ban #{user.name || user.email}?"}
                  class="rounded-md px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
                >
                  Ban
                </button>
                <button
                  :if={user.banned and user.id != @current_user.id}
                  phx-click="unban"
                  phx-value-id={user.id}
                  class="rounded-md px-2.5 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-50"
                >
                  Unban
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</.admin_shell>
