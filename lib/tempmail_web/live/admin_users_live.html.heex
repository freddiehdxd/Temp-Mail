<.admin_shell locale={@locale} active={:users}>
  <% users = filtered_users(@users, @search) %>
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-950">Users</h1>
      <p class="mt-1 text-slate-500">Manage user accounts and permissions.</p>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <.form for={%{}} phx-change="search">
        <div class="relative max-w-md">
          <.icon
            name="hero-magnifying-glass"
            class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
          />
          <input
            name="search"
            value={@search}
            placeholder="Search users..."
            class="h-11 w-full rounded-lg border border-slate-200 bg-white pl-10 pr-3 text-sm"
          />
        </div>
      </.form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5">
        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
          <.icon name="hero-users" class="h-5 w-5" /> All Users ({length(users)})
        </h2>
      </div>
      <div class="space-y-4 p-5">
        <div :if={users == []} class="py-12 text-center">
          <.icon name="hero-users" class="mx-auto h-12 w-12 text-slate-300" />
          <h3 class="mt-4 text-lg font-medium text-slate-950">No users found</h3>
        </div>
        <div
          :for={user <- users}
          class="flex flex-col gap-4 rounded-lg border border-slate-200 p-4 transition-colors hover:bg-slate-50 lg:flex-row lg:items-center lg:justify-between"
        >
          <div class="flex items-center gap-4">
            <img :if={user.image} src={user.image} class="h-10 w-10 rounded-full" alt="" />
            <div
              :if={!user.image}
              class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-200"
            >
              <.icon name="hero-users" class="h-5 w-5 text-slate-500" />
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-medium text-slate-950">{user.name || "Unnamed User"}</span>
                <span
                  :if={user.role == "SUPER_ADMIN"}
                  class="rounded-full bg-purple-600 px-2 py-1 text-xs font-bold text-white"
                >
                  Super Admin
                </span>
                <span
                  :if={user.role == "ADMIN"}
                  class="rounded-full bg-blue-600 px-2 py-1 text-xs font-bold text-white"
                >
                  Admin
                </span>
                <span
                  :if={user.banned}
                  class="rounded-full bg-red-600 px-2 py-1 text-xs font-bold text-white"
                >
                  Banned
                </span>
              </div>
              <p class="text-sm text-slate-500">{user.email}</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm text-slate-500">
              Joined {Calendar.strftime(user.inserted_at, "%b %d, %Y")}
            </span>
            <button
              :if={
                @current_user.role == "SUPER_ADMIN" && @current_user.id != user.id &&
                  user.role != "SUPER_ADMIN"
              }
              phx-click="toggle_admin"
              phx-value-id={user.id}
              class={
                if user.role == "ADMIN", do: "tm-btn-gradient gap-1", else: "tm-btn-outline gap-1"
              }
            >
              <.icon name="hero-shield-check" class="h-4 w-4" /> {if user.role == "ADMIN",
                do: "Admin",
                else: "Make Admin"}
            </button>
            <button
              :if={@current_user.id != user.id && user.role != "SUPER_ADMIN" && !user.banned}
              phx-click="ban"
              phx-value-id={user.id}
              class="tm-btn border border-red-200 bg-red-50 text-red-700"
            >
              <.icon name="hero-no-symbol" class="h-4 w-4" /> Ban
            </button>
            <button
              :if={@current_user.id != user.id && user.banned}
              phx-click="unban"
              phx-value-id={user.id}
              class="tm-btn-outline gap-1"
            >
              <.icon name="hero-check" class="h-4 w-4" /> Unban
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</.admin_shell>
