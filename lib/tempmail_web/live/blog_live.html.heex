<div class="container mx-auto max-w-4xl px-4 py-12">
  <header class="mb-10">
    <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl">Blog</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">
      Guides from the team that runs TempMail Central: when a disposable inbox is the right
      tool, when it is not, and how the service works under the hood.
    </p>
  </header>

  <div class="grid gap-5">
    <article
      :for={post <- @posts}
      class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md sm:p-7"
    >
      <% translation = TempmailWeb.BlogLive.post_translation(post, @locale) %>
      <div class="mb-2 flex items-center gap-3 text-xs text-slate-400">
        <time :if={post.published_at} datetime={DateTime.to_iso8601(post.published_at)}>
          {Calendar.strftime(post.published_at, "%B %-d, %Y")}
        </time>
      </div>
      <.link
        navigate={
          if @locale == "en", do: ~p"/blog/#{post.slug}", else: "/#{@locale}/blog/#{post.slug}"
        }
        class="text-xl font-bold text-slate-950 transition-colors group-hover:text-indigo-700"
      >
        {(translation && translation.title) || post.slug}
      </.link>
      <p :if={translation && translation.excerpt} class="mt-2 text-sm leading-relaxed text-slate-500">
        {translation.excerpt}
      </p>
    </article>

    <div
      :if={@posts == []}
      class="rounded-2xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500"
    >
      New articles are on the way - check back shortly.
    </div>
  </div>
</div>
