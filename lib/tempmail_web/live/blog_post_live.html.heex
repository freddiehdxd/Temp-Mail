<div class="container mx-auto max-w-3xl px-4 py-12">
  <.link
    navigate={if @locale == "en", do: ~p"/blog", else: "/#{@locale}/blog"}
    class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-indigo-600"
  >
    <.icon name="hero-arrow-left" class="h-4 w-4" /> Blog
  </.link>

  <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
    <header class="mb-8 border-b border-slate-100 pb-8">
      <h1 class="text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">
        {(@translation && @translation.title) || @post.slug}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
        <span class="inline-flex items-center gap-1.5">
          <.icon name="hero-user-circle" class="h-4 w-4" /> TempMail Central team
        </span>
        <time :if={@post.published_at} datetime={DateTime.to_iso8601(@post.published_at)}>
          {Calendar.strftime(@post.published_at, "%B %-d, %Y")}
        </time>
        <span class="inline-flex items-center gap-1.5">
          <.icon name="hero-clock" class="h-4 w-4" /> {@reading_minutes} min read
        </span>
      </div>
    </header>
    <div class="prose prose-slate max-w-none prose-headings:font-semibold prose-a:text-indigo-600">
      <%= if @translation do %>
        {Phoenix.HTML.raw(@translation.content)}
      <% end %>
    </div>
  </article>

  <div class="mt-10 rounded-2xl bg-gradient-to-r from-indigo-600 to-purple-600 p-8 text-center text-white">
    <h2 class="mb-2 text-xl font-bold">Try it yourself</h2>
    <p class="mx-auto mb-5 max-w-md text-sm text-indigo-100">
      A disposable inbox takes one click and deletes itself when the timer runs out.
    </p>
    <.link
      navigate={if @locale == "en", do: ~p"/", else: "/#{@locale}"}
      class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-indigo-600 transition-all hover:scale-105"
    >
      Open the generator <.icon name="hero-arrow-right" class="h-4 w-4" />
    </.link>
  </div>
</div>
