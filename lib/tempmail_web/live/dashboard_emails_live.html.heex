<.dashboard_shell current_user={@current_user} locale={@locale} active={@active}>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-slate-950">{@title}</h1>
      <p class="mt-1 text-slate-500">{@subtitle}</p>
    </div>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5">
        <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
          <.icon
            name={if @active == :starred, do: "hero-star", else: "hero-archive-box"}
            class="h-5 w-5 text-indigo-500"
          />
          {@title} Emails ({length(@emails)})
        </h2>
      </div>
      <div class="divide-y divide-slate-100">
        <div :if={@emails == []} class="p-12 text-center">
          <.icon
            name={if @active == :starred, do: "hero-star", else: "hero-archive-box"}
            class="mx-auto h-12 w-12 text-slate-300"
          />
          <p class="mt-3 font-medium text-slate-950">Nothing here yet</p>
          <p class="text-sm text-slate-500">
            Emails will appear here after you update them in a mailbox.
          </p>
        </div>

        <div :for={email <- @emails} class="flex items-center gap-4 p-4 hover:bg-slate-50">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 font-semibold text-white">
            {String.first(email.from || "?") |> String.upcase()}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p class="truncate font-medium text-slate-950">{email.from_name || email.from}</p>
              <.icon :if={email.starred} name="hero-star" class="h-4 w-4 text-amber-500" />
            </div>
            <p class="truncate text-sm text-slate-500">{email.subject || "(No Subject)"}</p>
            <p class="truncate text-xs text-slate-500">Mailbox: {email.mailbox.address}</p>
          </div>
          <div class="flex gap-2">
            <button
              phx-click="toggle_star"
              phx-value-id={email.id}
              class="rounded-lg p-2 hover:bg-slate-100"
            >
              <.icon
                name="hero-star"
                class={if email.starred, do: "h-5 w-5 text-amber-500", else: "h-5 w-5"}
              />
            </button>
            <button
              phx-click="toggle_archive"
              phx-value-id={email.id}
              class="rounded-lg p-2 hover:bg-slate-100"
            >
              <.icon
                name="hero-archive-box"
                class={if email.archived, do: "h-5 w-5 text-indigo-500", else: "h-5 w-5"}
              />
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</.dashboard_shell>
