<.dashboard_shell current_user={@current_user} locale={@locale} active={:settings}>
  <div class="max-w-4xl space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-slate-950">Settings</h1>
      <p class="mt-1 text-slate-500">Manage your account preferences.</p>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
        <.icon name="hero-user" class="h-5 w-5" /> Profile
      </h2>
      <p class="mt-1 text-sm text-slate-500">Your signed-in account information.</p>
      <div class="mt-5 flex items-center gap-4">
        <img
          :if={@current_user.image}
          src={@current_user.image}
          class="h-16 w-16 rounded-full"
          alt=""
        />
        <div
          :if={!@current_user.image}
          class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-xl font-semibold text-white"
        >
          {String.first(@current_user.name || @current_user.email || "?") |> String.upcase()}
        </div>
        <div>
          <p class="text-lg font-semibold text-slate-950">{@current_user.name || "User"}</p>
          <p class="text-slate-500">{@current_user.email}</p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="flex items-center gap-2 text-lg font-bold text-slate-950">
        <.icon name="hero-envelope" class="h-5 w-5" /> Email Preferences
      </h2>
      <div class="mt-5 space-y-4">
        <div class="flex items-center justify-between rounded-lg bg-slate-50 p-4">
          <div>
            <p class="font-medium text-slate-950">Auto mark as read</p>
            <p class="text-sm text-slate-500">Messages are marked as read when opened.</p>
          </div>
          <input type="checkbox" checked class="h-5 w-5 rounded border-slate-300 text-indigo-600" />
        </div>
        <div class="flex items-center justify-between rounded-lg bg-slate-50 p-4">
          <div>
            <p class="font-medium text-slate-950">Default expiry</p>
            <p class="text-sm text-slate-500">Default lifetime for temporary emails.</p>
          </div>
          <select class="rounded-lg border border-slate-200 bg-white px-3 py-2">
            <option>10 minutes</option>
            <option>1 hour</option>
            <option>24 hours</option>
          </select>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-red-200 bg-white p-6 shadow-sm">
      <h2 class="flex items-center gap-2 text-lg font-bold text-red-600">
        <.icon name="hero-trash" class="h-5 w-5" /> Danger Zone
      </h2>
      <div class="mt-5 grid gap-4">
        <div class="flex items-center justify-between rounded-lg bg-red-50 p-4">
          <div>
            <p class="font-medium text-slate-950">Delete all mailboxes</p>
            <p class="text-sm text-slate-500">Remove all persistent mailbox data.</p>
          </div>
          <button class="tm-btn border border-red-200 bg-red-100 text-red-700">Delete All</button>
        </div>
      </div>
    </section>
  </div>
</.dashboard_shell>
