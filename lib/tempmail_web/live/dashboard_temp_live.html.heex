<.dashboard_shell current_user={@current_user} locale={@locale} active={:temp}>
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-950">Temp Emails</h1>
        <p class="mt-1 text-slate-500">
          Generate and receive temporary mail from your dashboard.
        </p>
      </div>
      <.form for={%{}} phx-submit="generate" class="flex flex-wrap gap-2">
        <select
          name="domain"
          class="h-11 rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold"
        >
          <option value="">Random domain</option>
          <option :for={domain <- @domains} value={domain.domain}>{domain.domain}</option>
        </select>
        <button class="tm-btn-gradient gap-2">
          <.icon name="hero-plus" class="h-5 w-5" /> New Temp Email
        </button>
      </.form>
    </div>

    <div
      :if={@error}
      class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
    >
      {@error}
    </div>

    <section class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <div class="tm-gradient-bar h-1"></div>
      <div class="grid gap-6 p-5 lg:grid-cols-[1fr_20rem]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
            Current Temporary Address
          </p>
          <div class="mt-3 flex flex-col gap-3 rounded-2xl bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="break-all font-mono text-xl font-black text-slate-950">
              {(@temp_email && temp_address(%{assigns: %{temp_email: @temp_email}})) ||
                "Generating..."}
            </p>
            <button
              :if={@temp_email}
              type="button"
              phx-hook="Clipboard"
              data-copy={temp_address(%{assigns: %{temp_email: @temp_email}})}
              class="tm-btn-outline gap-2"
              id="dashboard-temp-copy"
            >
              <.icon name="hero-clipboard" class="h-4 w-4" /> Copy
            </button>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button phx-click="refresh" class="tm-btn-outline gap-2">
              <.icon name="hero-arrow-path" class="h-4 w-4" /> Refresh Inbox
            </button>
            <button phx-click="save" class="tm-btn-outline gap-2">
              <.icon name="hero-bookmark" class="h-4 w-4" /> Save as Mailbox
            </button>
            <button phx-click="extend" phx-value-duration="hour" class="tm-btn-outline">
              +1 hour
            </button>
            <button phx-click="extend" phx-value-duration="day" class="tm-btn-outline">
              +24 hours
            </button>
          </div>
        </div>
        <div class="rounded-2xl bg-indigo-50 p-5">
          <p class="text-sm font-semibold text-indigo-700">Time Remaining</p>
          <p class="mt-2 text-4xl font-black text-indigo-950">{format_ttl(@ttl)}</p>
          <p class="mt-2 text-sm text-indigo-700">Live updates enabled through WebSockets.</p>
        </div>
      </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 p-5">
          <div>
            <h2 class="text-lg font-bold text-slate-950">Inbox</h2>
            <p class="text-sm text-slate-500">{length(@emails)} messages received</p>
          </div>
          <span
            :if={Enum.any?(@emails, &(&1["read"] != true))}
            class="rounded-full bg-indigo-500 px-3 py-1 text-xs font-bold text-white"
          >
            {Enum.count(@emails, &(&1["read"] != true))} unread
          </span>
        </div>

        <div :if={@selected_email} class="border-b border-slate-200 bg-white">
          <div class="flex items-center justify-between border-b border-slate-100 p-4">
            <button phx-click="back" class="tm-btn-outline gap-2">
              <.icon name="hero-arrow-left" class="h-4 w-4" /> Back
            </button>
            <button
              phx-click="delete"
              phx-value-id={@selected_email["id"]}
              class="tm-btn border border-red-200 bg-red-50 text-red-700"
            >
              <.icon name="hero-trash" class="h-4 w-4" /> Delete
            </button>
          </div>
          <div class="max-h-[520px] overflow-auto p-6">
            <h3 class="text-2xl font-bold text-slate-950">
              {@selected_email["subject"] || "(No Subject)"}
            </h3>
            <p class="mt-2 text-sm text-slate-500">
              From {@selected_email["from"]} · {format_received(@selected_email["receivedAt"])}
            </p>
            <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
              <div :if={@selected_email["html"] not in [nil, ""]}>
                {Phoenix.HTML.raw(@selected_email["html"])}
              </div>
              <pre
                :if={@selected_email["html"] in [nil, ""]}
                class="whitespace-pre-wrap font-sans text-sm"
              >{@selected_email["text"] || "No content"}</pre>
            </div>
          </div>
        </div>

        <div :if={!@selected_email} class="divide-y divide-slate-100">
          <div :if={@emails == []} class="p-12 text-center">
            <.icon name="hero-envelope-open" class="mx-auto h-16 w-16 text-slate-300" />
            <p class="mt-4 text-lg font-semibold text-slate-950">Inbox is empty</p>
            <p class="text-sm text-slate-500">
              Messages sent to your temporary address will appear here instantly.
            </p>
          </div>
          <button
            :for={email <- @emails}
            phx-click="select"
            phx-value-id={email["id"]}
            class={[
              "flex w-full items-center gap-4 p-4 text-left transition-colors hover:bg-slate-50",
              email["read"] != true && "bg-indigo-50/50"
            ]}
          >
            <div class={[
              "flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full",
              email["read"] == true && "bg-slate-100",
              email["read"] != true && "bg-gradient-to-br from-indigo-500 to-purple-600"
            ]}>
              <.icon
                :if={email["read"] == true}
                name="hero-envelope"
                class="h-4 w-4 text-slate-400"
              />
              <span :if={email["read"] != true} class="font-semibold text-white">
                {email_initial(email)}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <p class={[
                "truncate",
                email["read"] != true && "font-semibold text-slate-950",
                email["read"] == true && "text-slate-500"
              ]}>
                {email["from"]}
              </p>
              <p class="truncate text-sm text-slate-500">{email["subject"] || "(No Subject)"}</p>
              <p class="truncate text-xs text-slate-400">{email_preview(email)}</p>
            </div>
            <span class="hidden text-xs text-slate-500 sm:block">
              {format_received(email["receivedAt"])}
            </span>
          </button>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 p-5">
          <h2 class="text-lg font-bold text-slate-950">Recent Temp Addresses</h2>
          <p class="text-sm text-slate-500">Generated while signed in</p>
        </div>
        <div class="max-h-[560px] divide-y divide-slate-100 overflow-auto">
          <div :if={@sessions == []} class="p-8 text-center text-sm text-slate-500">
            No temp history yet.
          </div>
          <div :for={session <- @sessions} class="p-4">
            <p class="break-all font-mono text-sm font-semibold text-slate-950">
              {session.address}
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <span class={[
                "rounded-full px-2 py-1 text-xs font-bold",
                session.is_permanent && "bg-indigo-50 text-indigo-700",
                !session.is_permanent && "bg-slate-100 text-slate-600"
              ]}>
                {if session.is_permanent, do: "Saved", else: "Temporary"}
              </span>
              <span class="text-xs text-slate-500">
                Expires {Calendar.strftime(session.expires_at, "%b %d, %Y")}
              </span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</.dashboard_shell>
