<.dashboard_shell current_user={@current_user} locale={@locale} active={:mailboxes}>
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-950">My Mailboxes</h1>
        <p class="mt-1 text-slate-500">
          {length(@mailboxes)} permanent email {if length(@mailboxes) == 1,
            do: "address",
            else: "addresses"}
        </p>
      </div>
      <button phx-click="show_new" class="tm-btn-gradient gap-2">
        <.icon name="hero-plus" class="h-5 w-5" /> New Mailbox
      </button>
    </div>

    <div
      :if={@error}
      class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
    >
      {@error}
    </div>

    <div :if={@show_new} class="rounded-2xl border-2 border-indigo-500 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 p-5">
        <h2 class="text-lg font-bold text-slate-950">Create New Mailbox</h2>
        <button phx-click="hide_new" class="rounded-lg p-2 hover:bg-slate-100">
          <.icon name="hero-x-mark" class="h-4 w-4" />
        </button>
      </div>
      <.form for={@form} phx-submit="create" class="space-y-4 p-5">
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-700">Email Address</label>
          <div class="grid gap-2 sm:grid-cols-[1fr_auto_1fr]">
            <input
              name="prefix"
              value={@form[:prefix].value}
              placeholder="name"
              class="h-11 rounded-lg border border-slate-200 bg-white px-3 text-sm"
            />
            <span class="flex items-center text-slate-500">@</span>
            <select
              name="domain"
              class="h-11 rounded-lg border border-slate-200 bg-white px-3 text-sm"
            >
              <option
                :for={domain <- @domains}
                value={domain.domain}
                selected={domain.domain == @form[:domain].value}
              >
                {domain.domain}
              </option>
            </select>
          </div>
          <p class="mt-1 text-xs text-slate-500">
            Leave prefix empty to generate a random address.
          </p>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-slate-700">Friendly Name</label>
          <input
            name="name"
            value={@form[:name].value}
            placeholder="Shopping, Work, Newsletter..."
            class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm"
          />
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" phx-click="hide_new" class="tm-btn-outline">Cancel</button>
          <button class="tm-btn-gradient">Create New</button>
        </div>
      </.form>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="space-y-3">
        <div
          :if={@mailboxes == []}
          class="rounded-2xl border border-slate-200 bg-white p-8 text-center"
        >
          <.icon name="hero-inbox" class="mx-auto h-12 w-12 text-slate-300" />
          <p class="mt-3 font-medium text-slate-950">No mailboxes</p>
          <p class="mb-4 text-sm text-slate-500">Create a permanent mailbox to store messages.</p>
          <button phx-click="show_new" class="tm-btn-gradient gap-2">
            <.icon name="hero-plus" class="h-4 w-4" /> Create New
          </button>
        </div>

        <div
          :for={mailbox <- @mailboxes}
          class={[
            "rounded-2xl border bg-white p-4 shadow-sm transition-all hover:shadow-md",
            @selected_mailbox && @selected_mailbox.id == mailbox.id && "ring-2 ring-indigo-500"
          ]}
        >
          <button
            phx-click="select_mailbox"
            phx-value-id={mailbox.id}
            class="w-full text-left"
          >
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600">
                <.icon name="hero-envelope" class="h-5 w-5 text-white" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="truncate font-medium text-slate-950">
                    {mailbox.name || mailbox.prefix}
                  </span>
                  <.icon :if={mailbox.is_primary} name="hero-star" class="h-4 w-4 text-amber-500" />
                </div>
                <p class="truncate text-sm text-slate-500">{mailbox.address}</p>
              </div>
              <% unread = Enum.count(mailbox.emails, fn email -> !email.read end) %>
              <span
                :if={unread > 0}
                class="rounded-full bg-indigo-500 px-2 py-1 text-xs font-semibold text-white"
              >
                {unread}
              </span>
            </div>
          </button>
          <div class="mt-2 flex items-center gap-2 pl-[52px]">
            <button
              id={"copy-mailbox-#{mailbox.id}"}
              phx-hook="Clipboard"
              data-copy={mailbox.address}
              class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
            >
              <.icon name="hero-clipboard-mini" class="h-3.5 w-3.5" /> Copy
            </button>
            <button
              phx-click="delete_mailbox"
              phx-value-id={mailbox.id}
              data-confirm={"Delete #{mailbox.address}? All emails will be lost."}
              class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
            >
              <.icon name="hero-trash-mini" class="h-3.5 w-3.5" /> Delete
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div
          :if={!@selected_mailbox}
          class="flex h-[600px] items-center justify-center rounded-2xl border border-slate-200 bg-white"
        >
          <div class="text-center">
            <.icon name="hero-inbox" class="mx-auto h-16 w-16 text-slate-300" />
            <p class="mt-4 text-lg font-medium text-slate-950">Select a mailbox</p>
            <p class="text-slate-500">Choose a mailbox to view its emails.</p>
          </div>
        </div>

        <div
          :if={@selected_mailbox && @selected_email}
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
        >
          <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 p-4">
            <button phx-click="back_to_list" class="tm-btn-outline gap-2">
              <.icon name="hero-arrow-left" class="h-4 w-4" /> Back
            </button>
            <div class="flex items-center gap-2">
              <button
                phx-click="toggle_star"
                phx-value-id={@selected_email.id}
                class="rounded-lg p-2 hover:bg-slate-100"
              >
                <.icon
                  name="hero-star"
                  class={
                    if @selected_email.starred, do: "h-5 w-5 text-amber-500", else: "h-5 w-5"
                  }
                />
              </button>
              <button
                phx-click="delete_email"
                phx-value-id={@selected_email.id}
                class="tm-btn border border-red-200 bg-red-50 text-red-700"
              >
                <.icon name="hero-trash" class="h-4 w-4" /> Delete
              </button>
            </div>
          </div>
          <div class="max-h-[550px] overflow-auto p-6">
            <h2 class="mb-4 text-2xl font-bold text-slate-950">
              {@selected_email.subject || "(No Subject)"}
            </h2>
            <div class="mb-6 flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 font-semibold text-white">
                {String.first(@selected_email.from || "?") |> String.upcase()}
              </div>
              <div>
                <p class="font-medium text-slate-950">
                  {@selected_email.from_name || @selected_email.from}
                </p>
                <p class="text-sm text-slate-500">
                  {Calendar.strftime(@selected_email.received_at, "%b %d, %Y %I:%M %p")}
                </p>
              </div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <div :if={@selected_email.html} class="prose max-w-none">
                {Phoenix.HTML.raw(@selected_email.html)}
              </div>
              <pre :if={!@selected_email.html} class="whitespace-pre-wrap font-sans text-sm">{@selected_email.text || "No content"}</pre>
            </div>
          </div>
        </div>

        <div
          :if={@selected_mailbox && !@selected_email}
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
        >
          <div class="flex items-center justify-between border-b border-slate-200 p-4">
            <div>
              <h2 class="font-semibold text-slate-950">
                {@selected_mailbox.name || @selected_mailbox.address}
              </h2>
              <p class="text-sm text-slate-500">{length(@selected_mailbox.emails)} emails</p>
            </div>
            <button
              phx-click="delete_mailbox"
              phx-value-id={@selected_mailbox.id}
              class="rounded-lg p-2 text-red-500 hover:bg-red-50"
            >
              <.icon name="hero-trash" class="h-5 w-5" />
            </button>
          </div>
          <div class="max-h-[550px] overflow-auto divide-y divide-slate-100">
            <div :if={@selected_mailbox.emails == []} class="p-12 text-center">
              <.icon name="hero-envelope" class="mx-auto h-12 w-12 text-slate-300" />
              <p class="mt-3 font-medium text-slate-950">No emails yet</p>
              <p class="text-sm text-slate-500">
                Emails sent to {@selected_mailbox.address} will appear here.
              </p>
            </div>
            <button
              :for={email <- @selected_mailbox.emails}
              phx-click="select_email"
              phx-value-id={email.id}
              class={[
                "flex w-full items-center gap-4 p-4 text-left transition-colors hover:bg-slate-50",
                !email.read && "bg-indigo-50/50"
              ]}
            >
              <div class={[
                "flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full",
                email.read && "bg-slate-100",
                !email.read && "bg-gradient-to-br from-indigo-500 to-purple-600"
              ]}>
                <.icon :if={email.read} name="hero-envelope" class="h-4 w-4 text-slate-400" />
                <span :if={!email.read} class="text-sm font-semibold text-white">
                  {String.first(email.from || "?") |> String.upcase()}
                </span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class={["truncate", !email.read && "font-semibold"]}>
                    {email.from_name || email.from}
                  </span>
                  <span :if={!email.read} class="h-2 w-2 rounded-full bg-indigo-500"></span>
                  <.icon :if={email.starred} name="hero-star" class="h-4 w-4 text-amber-500" />
                </div>
                <p class={[
                  "truncate text-sm",
                  !email.read && "font-medium",
                  email.read && "text-slate-500"
                ]}>
                  {email.subject || "(No Subject)"}
                </p>
              </div>
              <span class="hidden text-xs text-slate-500 sm:block">
                {Calendar.strftime(email.received_at, "%b %d")}
              </span>
              <.icon name="hero-chevron-right" class="h-4 w-4 text-slate-400" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</.dashboard_shell>
