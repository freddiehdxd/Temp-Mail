<.dashboard_shell current_user={@current_user} locale={@locale} active={:domains}>
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-950">Custom Domains</h1>
        <p class="mt-1 text-slate-500">
          Add a domain and point MX/SPF records at your mail stack.
        </p>
      </div>
    </div>

    <div
      :if={@error}
      class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
    >
      {@error}
    </div>

    <.form
      for={@form}
      phx-submit="create"
      class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[1fr_auto]"
    >
      <input
        name="domain"
        value={@form[:domain].value}
        placeholder="example.com"
        class="h-12 min-w-0 rounded-xl border-2 border-slate-200 bg-white px-4 text-sm font-semibold"
      />
      <button class="tm-btn-gradient h-12 gap-2">
        <.icon name="hero-plus" class="h-5 w-5" /> Add Domain
      </button>
    </.form>

    <div
      :if={@domains == []}
      class="rounded-2xl border border-slate-200 bg-white p-12 text-center"
    >
      <.icon name="hero-globe-alt" class="mx-auto h-16 w-16 text-slate-300" />
      <h3 class="mt-4 text-lg font-semibold text-slate-950">No domains</h3>
      <p class="text-slate-500">
        Add your first custom domain to receive mail on your own address.
      </p>
    </div>

    <div class="space-y-4">
      <article
        :for={domain <- @domains}
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex gap-3">
            <div class={[
              "flex h-10 w-10 items-center justify-center rounded-lg",
              domain.is_verified && "bg-green-100",
              !domain.is_verified && "bg-amber-100"
            ]}>
              <.icon
                name="hero-globe-alt"
                class={
                  if domain.is_verified,
                    do: "h-5 w-5 text-green-600",
                    else: "h-5 w-5 text-amber-600"
                }
              />
            </div>
            <div>
              <% results = Map.get(@verification_results, domain.id) %>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-semibold text-slate-950">{domain.domain}</h2>
                <span class={[
                  "rounded-full px-2.5 py-1 text-xs font-bold",
                  domain.is_verified && "bg-green-100 text-green-700",
                  !domain.is_verified && "bg-amber-100 text-amber-700"
                ]}>
                  {if domain.is_verified, do: "Verified", else: "Pending Verification"}
                </span>
              </div>
              <div class="mt-4 grid gap-3 rounded-xl bg-slate-50 p-4 text-sm">
                <div>
                  <p class="font-semibold text-slate-700">Step 1: Ownership TXT</p>
                  <p class="mt-1 text-slate-500">Type: TXT - Name: _tempmail-verify - Value:</p>
                  <p class="break-all font-mono text-slate-950">{domain.verification_token}</p>
                </div>
                <div>
                  <p class="font-semibold text-slate-700">Step 2: MX Record</p>
                  <p class="mt-1 text-slate-500">Type: MX - Name: @ - Priority: 10 - Value:</p>
                  <p class="break-all font-mono text-slate-950">
                    {Application.get_env(
                      :tempmail,
                      :mail_server_hostname,
                      "mail.tempmailcentral.com"
                    )}
                  </p>
                </div>
                <div>
                  <p class="font-semibold text-slate-700">
                    Step 3: SPF Record <span class="font-normal text-slate-500">(optional)</span>
                  </p>
                  <p class="mt-1 text-slate-500">Type: TXT - Name: @ - Value:</p>
                  <p class="break-all font-mono text-slate-950">
                    v=spf1 mx a include:{Application.get_env(
                      :tempmail,
                      :mail_server_hostname,
                      "mail.tempmailcentral.com"
                    )} -all
                  </p>
                </div>
              </div>
              <div class="mt-3 flex flex-wrap gap-2 text-xs font-bold">
                <span class={[
                  "rounded-full px-2.5 py-1",
                  results && results.ownership && "bg-green-100 text-green-700",
                  (!results || !results.ownership) && "bg-slate-100 text-slate-600"
                ]}>
                  Ownership: {if results && results.ownership, do: "verified", else: "pending"}
                </span>
                <span class={[
                  "rounded-full px-2.5 py-1",
                  domain.mx_verified && "bg-green-100 text-green-700",
                  !domain.mx_verified && "bg-slate-100 text-slate-600"
                ]}>
                  MX: {if domain.mx_verified, do: "verified", else: "pending"}
                </span>
                <span class={[
                  "rounded-full px-2.5 py-1",
                  domain.spf_verified && "bg-green-100 text-green-700",
                  !domain.spf_verified && "bg-slate-100 text-slate-600"
                ]}>
                  SPF: {if domain.spf_verified, do: "verified", else: "optional"}
                </span>
              </div>
              <div
                :if={results && results.errors != []}
                class="mt-3 rounded-lg bg-red-50 p-3 text-sm text-red-700"
              >
                <p class="font-semibold">DNS errors:</p>
                <ul class="mt-1 list-disc space-y-1 pl-5">
                  <li :for={error <- results.errors}>{error}</li>
                </ul>
              </div>
            </div>
          </div>
          <div class="flex gap-2">
            <button phx-click="verify" phx-value-id={domain.id} class="tm-btn-gradient gap-2">
              <.icon name="hero-arrow-path" class="h-4 w-4" /> Verify DNS
            </button>
            <button
              phx-click="delete"
              phx-value-id={domain.id}
              data-confirm="Remove this domain?"
              class="tm-btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100"
            >
              <.icon name="hero-trash" class="h-4 w-4" /> Delete
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</.dashboard_shell>
